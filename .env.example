# ContextIQ configuration
# Copy to .env for local development.

# Answer provider: "openrouter" (default, minimax-m3) or "anthropic" (Citations-API seam).
CONTEXTIQ_LLM_PROVIDER=openrouter

# OpenRouter answer model (minimax-m3, paid ~$0.001/query). Key also used for mistral-ocr parsing.
OPENROUTER_API_KEY=your_openrouter_api_key
CONTEXTIQ_OPENROUTER_MODEL=minimax/minimax-m3

# Only needed when CONTEXTIQ_LLM_PROVIDER=anthropic (airtight Citations-API grounding).
# Without any key, ContextIQ returns an extractive fallback from retrieved evidence.
ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional overrides
CONTEXTIQ_DATA_DIR=data
CONTEXTIQ_QDRANT_PATH=data/qdrant
CONTEXTIQ_DEFAULT_MODEL=claude-sonnet-4-5
CONTEXTIQ_ANSWER_MAX_TOKENS=1000
