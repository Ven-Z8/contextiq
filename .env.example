# ContextIQ configuration
# Copy to .env for local development.

# Optional: enables grounded Claude answer synthesis.
# Without this, ContextIQ returns an extractive fallback from retrieved evidence.
ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional overrides
CONTEXTIQ_DATA_DIR=data
CONTEXTIQ_QDRANT_PATH=data/qdrant
CONTEXTIQ_DEFAULT_MODEL=claude-sonnet-4-5
CONTEXTIQ_ANSWER_MAX_TOKENS=1000
